# syntax=docker/dockerfile:1.7

# Dockerfile.server — production-like запуск без Gradle в runtime.

# 1) Build stage: собираем только backend-модули, без Android-части workspace.
FROM gradle:8.13-jdk21 AS build

WORKDIR /app

ARG KOTLIN_VERSION=2.2.20

ENV GRADLE_OPTS="-Djava.net.preferIPv4Stack=true -Dorg.gradle.internal.http.socketTimeout=1200000 -Dorg.gradle.internal.http.connectionTimeout=1200000"
ENV JAVA_OPTS="-Djava.net.preferIPv4Stack=true -Dorg.gradle.internal.http.socketTimeout=1200000 -Dorg.gradle.internal.http.connectionTimeout=1200000"

COPY gradle.properties ./
COPY server/ ./server/
COPY domain/ ./domain/
COPY rank/ ./rank/

# Версии плагинов задаём прямо тут, чтобы сборка backend не ходила в google()/plugin portal.
RUN cat <<EOF > settings.gradle.kts
rootProject.name = "shoppingassistant-server"

include(":server")
include(":domain")
include(":rank")

pluginManagement {
    plugins {
        id("org.jetbrains.kotlin.jvm") version "${KOTLIN_VERSION}"
        id("org.jetbrains.kotlin.plugin.serialization") version "${KOTLIN_VERSION}"
    }
    repositories {
        mavenCentral()
    }
    resolutionStrategy {
        eachPlugin {
            when (requested.id.id) {
                "org.jetbrains.kotlin.jvm" ->
                    useModule("org.jetbrains.kotlin:kotlin-gradle-plugin:${KOTLIN_VERSION}")
                "org.jetbrains.kotlin.plugin.serialization" ->
                    useModule("org.jetbrains.kotlin:kotlin-serialization:${KOTLIN_VERSION}")
            }
        }
    }
}

dependencyResolutionManagement {
    repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
    repositories {
        mavenCentral()
    }
}
EOF

RUN printf '\n' > build.gradle.kts

RUN --mount=type=cache,target=/home/gradle/.gradle \
    gradle --no-daemon :server:installDist

# 2) Runtime stage: запускаем только собранный server/bin/server.
FROM eclipse-temurin:21-jre

WORKDIR /opt/server

# Значения по умолчанию (могут быть переопределены в docker-compose.yml).
ENV APP_HOST=0.0.0.0
ENV APP_PORT=8081

COPY --from=build /app/build/server/install/server/ /opt/server/

EXPOSE 8081

CMD ["/opt/server/bin/server"]
