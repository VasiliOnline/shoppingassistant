{
  "schema_id": "schema_pack.tech_phones.v1_0",
  "categoryCode": "TECH.PHONES",
  "label_ru": "Телефоны",
  "pack_type": "public_category_pack",
  "public_category": true,
  "accepts_offers_directly": true,
  "inherits_from": [
    "TECH.ELECTRONICS_COMMON",
    "TECH.DEVICE_IDENTITY_COMMON",
    "TECH.SPECS_COMMON"
  ],
  "main_type_attribute": "phone_type",
  "identity_mode": "identity_critical",
  "compatibility_role": "target_device_for_accessories",
  "browse_branches": [
    {
      "branch_code": "PHONES.SMARTPHONES",
      "label_ru": "Смартфоны",
      "phone_type": "SMARTPHONE"
    },
    {
      "branch_code": "PHONES.FEATURE",
      "label_ru": "Кнопочные телефоны",
      "phone_type": "FEATURE_PHONE"
    },
    {
      "branch_code": "PHONES.FOLDABLE",
      "label_ru": "Складные телефоны",
      "phone_type": "FOLDABLE_PHONE"
    },
    {
      "branch_code": "PHONES.RUGGED",
      "label_ru": "Защищённые телефоны",
      "phone_type": "RUGGED_PHONE"
    },
    {
      "branch_code": "PHONES.RETRO",
      "label_ru": "Ретро / коллекционные телефоны",
      "phone_type": "RETRO_PHONE"
    },
    {
      "branch_code": "PHONES.SATELLITE",
      "label_ru": "Спутниковые телефоны",
      "phone_type": "SATELLITE_PHONE"
    }
  ],
  "attribute_roles": {
    "T0_CORE": [
      "categoryCode",
      "phone_type",
      "brand",
      "model_name_text",
      "storage_capacity_gb",
      "condition",
      "color_family",
      "price",
      "currency",
      "availability"
    ],
    "T1_TYPE_SPECIFIC": [
      "family",
      "line",
      "model",
      "model_number",
      "release_year",
      "region_variant",
      "ram_gb",
      "screen_size_inches",
      "os_family",
      "mobile_network_generation",
      "network_lock_status",
      "carrier",
      "sim_configuration",
      "esim_support",
      "battery_health_percent",
      "refurbished_status",
      "account_lock_status"
    ],
    "T2_OPTIONAL_ENRICHMENT": [
      "phone_form_factor",
      "battery_cycle_count",
      "screen_condition",
      "back_glass_condition",
      "frame_condition",
      "repair_history",
      "screen_replaced",
      "battery_replaced",
      "camera_condition",
      "button_condition",
      "water_damage_signs",
      "charger_included",
      "cable_included",
      "original_box",
      "receipt_available",
      "warranty_status",
      "dual_sim_support",
      "wireless_charging_support",
      "charging_connector",
      "fast_charging_watts",
      "camera_main_mp",
      "optical_zoom_x",
      "for_parts_only",
      "lot_type",
      "seller_bundle"
    ],
    "T3_SYSTEM_HIDDEN": [
      "identity_confidence",
      "identity_evidence",
      "identity_resolution_status",
      "model_resolution_candidates",
      "listing_completeness_confidence",
      "dedup_key",
      "route_confidence",
      "source_payload_hash",
      "vision_no_guess_reason",
      "imei_evidence_hash",
      "compliance_flags",
      "compatibility_target_id"
    ]
  },
  "publish_contract": {
    "required_for_public_offer": [
      "categoryCode",
      "phone_type",
      "brand",
      "model_name_text",
      "condition",
      "price",
      "currency",
      "availability",
      "images"
    ],
    "strongly_required_for_used_phone": [
      "network_lock_status",
      "battery_health_percent",
      "account_lock_status",
      "repair_history"
    ],
    "blocked_when": [
      {
        "field": "account_lock_status",
        "in": [
          "ICLOUD_LOCKED",
          "GOOGLE_FRP_LOCKED",
          "OWNER_ACCOUNT_LOCKED"
        ],
        "reason": "device_account_locked"
      },
      {
        "field": "imei_status",
        "in": [
          "BLACKLISTED",
          "REPORTED_STOLEN",
          "FINANCE_LOCKED"
        ],
        "reason": "device_reported_or_finance_locked"
      },
      {
        "field": "title",
        "contains_any": [
          "украден",
          "stolen",
          "lost phone"
        ],
        "reason": "unsafe_or_illegal_listing_signal"
      }
    ],
    "privacy": {
      "raw_imei_storage": "forbidden",
      "allowed": "imei_status + hashed evidence only"
    }
  },
  "runtime_resolution_order": [
    "gtin/ean/upc",
    "mpn/model_number",
    "brand+family+model aliases",
    "OCR box label",
    "seller declared title",
    "vision coarse class only"
  ]
}
