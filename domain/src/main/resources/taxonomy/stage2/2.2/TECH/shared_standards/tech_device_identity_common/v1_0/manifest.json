  "scope": {
    "purpose": "Единый standard identity для всех TECH public category packs: устройства, аксессуары, компоненты, audio/video/photo/gaming/networking/power/car electronics.",
    "included": [
      "brand/manufacturer/family/line/model identity surface",
      "model aliases / model number / MPN / GTIN/EAN/UPC identifier contract",
      "region variant / release year / generation / variant label semantics",
      "identity evidence, no-guess, review and confidence rules",
      "dedup identity key policy and route guardrails for device vs accessory/context claims"
    ],
    "excluded": [
      "full model head seed / official model registry",
      "technical specs values like RAM/storage/screen/battery/chipset",
      "compatibility refs compatible_brand/compatible_model",
      "TECH.PHONES and TECH.PHONE_ACCESSORIES public packs",
      "public microcategories such as TECH.IPHONE, TECH.CASES, TECH.CHARGERS, TECH.CABLES"
    ]
  },
