{
  "schema_id": "schema_pack.tech_specs_common.v1_0",
  "category_code": "TECH.SPECS_COMMON",
  "pack_type": "shared_standard_pack",
  "public_category": false,
  "accepts_offers_directly": false,
  "runtime_mount": "shared_standard_registry",
  "semantic_contract": {
    "ru": "Общий слой технических характеристик TECH: ёмкости, экран, питание, разъёмы, беспроводные стандарты, ОС, габариты, вес, защита, unit normalization, evidence/confidence. Не является публичной категорией и не содержит identity registry или compatibility refs.",
    "not_public_category": true,
    "not_identity_registry": true,
    "not_compatibility_registry": true,
    "not_phone_pack": true,
    "no_microcategory_mounts": true,
    "no_guess_rule": "Точная техническая характеристика допускается только при evidence из title/source attributes/OCR/barcode/manual confirmation. Фото внешнего вида без текста не доказывает exact storage/RAM/screen/battery/chipset."
  },
  "category_archetypes": [
    "SPECS_SHARED",
    "UNIT_NORMALIZATION",
    "EVIDENCE_GATED",
    "FACET_TEMPLATE_PROVIDER",
    "RANGE_AND_NUMERIC_SPECS",
    "NO_GUESS_VISION"
  ],
  "inherits_from": [
    "TECH.ELECTRONICS_COMMON",
    "TECH.DEVICE_IDENTITY_COMMON"
  ],
  "explicitly_excludes": [
    "TECH.COMPATIBILITY_COMMON",
    "TECH.PHONES",
    "TECH.PHONE_ACCESSORIES",
    "TECH_PHONES_IDENTITY_PACK_v1_0_RU",
    "TECH_PHONE_ACCESSORIES_COMPATIBILITY_PACK_v1_0_RU"
  ],
